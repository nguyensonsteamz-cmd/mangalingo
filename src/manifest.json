{
  "manifest_version": 3,
  "name": "LingoLens",
  "version": "0.0.0",
  "description": "Local-first English reading assistant: click/select lookup, manga OCR, EN→VI dictionary, grammar notes and a vocabulary notebook.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "LingoLens",
    "default_popup": "action/index.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel/index.html" },
  "options_ui": { "page": "options/index.html", "open_in_tab": true },
  "permissions": ["storage", "sidePanel", "offscreen", "contextMenus", "scripting", "identity"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open / close the reading sidebar"
    },
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Look up the selected text"
    },
    "scan-image": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Scan the manga image under the cursor (OCR)"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
